<Project Sdk="Godot.NET.Sdk/4.5.0">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableRuntimeMarshalling>true</EnableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PlatformTarget)'=='x64'">
      <DefineConstants>X64</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlatformTarget)'=='x86'">
      <DefineConstants>X86</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlatformTarget)'=='ARM64'">
      <DefineConstants>ARM64</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
</Project>